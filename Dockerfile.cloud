# 墨染酒馆云端公共剧本库（纯 Go 标准库，JSON 文件存储）
# 多阶段构建：golang 编译 → alpine 精简运行

# ---------- 阶段 1：编译 ----------
FROM golang:1.26-alpine AS build
WORKDIR /build
COPY cloud/go.mod cloud/main.go ./
RUN CGO_ENABLED=0 go build -trimpath -o /cloud-server .

# ---------- 阶段 2：运行（精简 alpine） ----------
FROM alpine:3.20
WORKDIR /app
COPY --from=build /cloud-server .
EXPOSE 8787
VOLUME ["/data"]
ENTRYPOINT ["./cloud-server", "-port", "8787", "-data", "/data"]
